{
  "name": "parametric-window-sealer-mcp",
  "version": "0.6.0",
  "description": "A local MCP server for LLM agents: plans the 3D-printable panels that close off the part of a window left open around a window air conditioner, fan or hose, and makes the STL or 3MF files to print.",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "window-sealer-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "parametric-window-sealer": "0.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fflate": "0.8.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
