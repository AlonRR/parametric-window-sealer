# --- secrets and local configuration (append to every repo's .gitignore) ---
#
# Measured 19 Sep 2026: of 41 repos, 8 had no .gitignore at all and only 2 covered all of
# .env, *.pem and *.key. A pattern here is cheaper than a history rewrite later.
#
# The pattern this estate actually uses for config: commit `<name>.example.<ext>` with
# placeholder values, gitignore the real file, and document the path in the README.
# smart-charger does this with include/config.hpp / include/config.example.hpp.

# environment and dotfiles
.env
.env.*
!.env.example
*.env

# keys, certificates, tokens
*.pem
*.key
!*.pub.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
*_rsa
*_ed25519
*.ppk
.netrc
.npmrc
*.token
*token.json
*credentials*.json
!*credentials*.example.json

# cloud and tool credential stores
.aws/
.azure/
.gcloud/
service-account*.json

# local, machine-specific or generated config
*.local
*.local.*
secrets.*
!secrets.example.*
config.local.*

# --- dependencies installed by npm (spikes/, later the web page) ---
node_modules/

# --- generated by the page's tools: the build (out/site) and browser-test results
# (out/playwright), under one parent so nothing generated sits beside the sources ---
web/out/
packages/*/dist/

# --- spikes: built pages and generated meshes, rebuilt by each spike's own scripts ---
spikes/*/out/
spikes/viewer-benchmark/public/meshes/
