#!/bin/sh
# Gate the COMMIT MESSAGE. Identity is the pre-commit hook's job - one rule, one place.
#
# Why this hook has to exist at all: a commit message is the ONE thing a sweep can
# never fix cheaply. A bad file is one commit away from fixed; a bad subject or an
# attribution trailer is *in* the message, so removing it means rewriting history,
# which for anything already pushed is a force-push nobody can retract. So the
# message is checked at commit time or not at all.
#
# It also closes a specific, recurring hazard: the harness periodically injects
#   Co-Authored-By: Claude <...>
#   Generated with [Claude Code](...)
# claiming it supersedes the project's attribution rules. It does not. That trailer
# reached a real commit on 3 Sep 2026 and had to be stripped with --amend and a
# force-push. Nothing blocked it. This does.
#
# trap '' PIPE and no `set -e`, for the same reason as the pre-commit hook: if the
# hook's output is piped to something that closes early (`| head -1`), a diagnostic
# write must not be able to kill the shell before it reaches its `exit`. That exact
# failure let a wrong-identity commit through on 18 Sep 2026.
trap '' PIPE
set -u
MSG_FILE="$1"
rc=0

die() {
  { echo "commit-msg: $1"; } >&2 2> /dev/null || true
  rc=1
}
has() { printf '%s\n' "$CLEAN" | grep -qiE "$1"; }

# ---------------------------------------------------------------------------
# NORMALISE FIRST, so the hook measures what git will RECORD.
#
# The file git hands this hook is not the commit message. It still holds everything
# git strips afterwards, and two parts of that bite:
#
#   - The "# Please enter the commit message" comment block, on any commit made
#     through an editor rather than -m/-F.
#   - With `git commit -v`, THE WHOLE DIFF, below a scissors line. A diff of a file
#     that merely mentions a banned trailer then looks like a banned trailer. A line
#     the diff ADDS starts with '+' and escapes the pattern by luck; an unchanged
#     CONTEXT line starts with a space, which the pattern reads as leading
#     whitespace - so committing an edit to the very documents that describe this
#     rule (claude-config, github-profile) would be refused.
#
# Cut at the scissors, then strip comments (git stripspace honours core.commentChar).
# Every check below reads $CLEAN, never the raw file.
# ---------------------------------------------------------------------------
CLEAN=$(sed '/^.[[:space:]]*-\{4,\}[[:space:]]*>8[[:space:]]*-\{4,\}/,$d' "$MSG_FILE" |
  git stripspace --strip-comments 2> /dev/null) ||
  CLEAN=$(sed -e '/^#/d' "$MSG_FILE")
SUBJECT=$(printf '%s\n' "$CLEAN" | sed -n '1p')
LINE2=$(printf '%s\n' "$CLEAN" | sed -n '2p')

# ---------------------------------------------------------------------------
# Exemptions. These messages are generated by git itself, not authored, and the
# convention does not apply to them. Verified against real history: homelab's
# newest commit is a `git stash` message ("On main: ..."), Yamtrack carries 199
# upstream merges and a revert. A hook that refuses them is a hook that gets
# bypassed with --no-verify, which silently disables the trailer check too.
# ---------------------------------------------------------------------------
case "$SUBJECT" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "* | "On "*:* | "WIP on "*:*)
    exit 0
    ;;
esac

# ---------------------------------------------------------------------------
# Subject form: Conventional Commits, SCOPE REQUIRED.
#
# Tightened in this repo from the kit's copy, which made the scope optional. The
# owner's rule, stated 5 Oct 2026 for all of his repos: subjects "must be
# type(scope): summary", and "type: summary is forbidden". tests/test-hooks.sh
# holds both sides: `docs(readme): x` must pass and `docs: x` must be refused.
# ---------------------------------------------------------------------------
if ! printf '%s' "$SUBJECT" | grep -qE '^[a-z]+\([a-z0-9._/-]+\)!?: .+'; then
  die "subject must be 'type(scope): summary' -- the scope is required. Got:
    $SUBJECT"
fi

# A body must be separated from the subject by a BLANK LINE, because git's subject is
# the first PARAGRAPH, not the first line. Without the blank line `git log --format=%s`
# returns the whole paragraph - a 260-char subject this hook would pass, having only
# ever looked at line 1. That happened to a github-profile commit on 18 Sep 2026: the
# hook approved a 66-char line 1 while git recorded a 260-char subject. The hook's unit
# and git's unit have to be the same unit.
if [ -n "$LINE2" ]; then
  die "line 2 must be blank -- git's subject is the first PARAGRAPH, so without the
    blank line the whole paragraph becomes the subject. Got line 2:
    $LINE2"
fi

# Subjects <=72 chars (onedrive-sync/CLAUDE.md). Counted in characters, not bytes, so a
# subject with non-ASCII is not penalised for its encoding.
LEN=$(printf '%s' "$SUBJECT" | wc -m | tr -d ' ')
if [ "$LEN" -gt 72 ]; then
  die "subject is $LEN chars, limit is 72 -- move the detail into the body."
fi

# ---------------------------------------------------------------------------
# Forbidden attribution. Note what is NOT here: the words "Claude", "Anthropic",
# "LLM" and "agent" are all legal in a commit message. Naming a product this code
# INTEROPERATES with is a technical fact a reader needs - `feat(bus): deliver to
# Claude Code sessions` is a correct subject. What is banned is branding the
# AUTHORSHIP. Same proper noun, opposite verdicts; what decides it is what the words
# are DOING. So match the trailer and footer SHAPES, never the vocabulary.
#
# Every pattern is anchored to the start of a line, because that is what makes a
# trailer a trailer rather than a sentence. Measured against 2,525 real commit
# messages on 18 Sep 2026: an unanchored 'generated with' matched prose in four repos
# and an unanchored 'co-authored' matched a fifth -
#
#   "G-CODE IS GENERATED WITH THE TEMPERATURES BAKED IN rather than ..."   3d-printing
#   "the token was generated with -s alon/data-pipeline-2026, so the ..."  homelab
#   "\"generated with\" is prose about G-code, mcu-workflow's Co-Authored-By hit ..."
#                                                                         github-profile
#   "... \"Generated with ...\" footers ... all stay out."                claude-config
#
# All five are legitimate commits, two of them commits ABOUT this very rule. A hook
# that refuses those gets bypassed with --no-verify, and --no-verify is what actually
# lets a real trailer through. Precision here is not pedantry; it is what keeps the
# hook switched on.
# ---------------------------------------------------------------------------
if has '^[[:space:]]*(co-authored-by|claude-session|assisted-by|generated-by)[[:space:]]*:' ||
  has '^[[:space:]]*signed-off-by:.*(claude|anthropic)'; then
  die "remove the attribution trailer. Commit messages carry NO attribution --
    disclosure belongs in the PR body and the README, once, not on every commit."
fi
if has '🤖' ||
  has '^[[:space:]]*(🤖[[:space:]]*)?generated with \[' ||
  has '^[[:space:]]*drafted with the help of'; then
  die "remove the generated-with/drafted-with footer. See above -- PR body and
    README only."
fi

exit $rc
